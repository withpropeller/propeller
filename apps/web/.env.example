# Copy to .env.local for local development.
#
# VITE_API_BASE_URL is the gateway origin the SPA talks to. The dev/stg/prod
# gateways' CORS allowlists include this app's origins; if you want to talk to
# prod from localhost, add http://localhost:3000 to the gateway's
# ALLOWED_ORIGINS first.
VITE_API_BASE_URL=https://gateway.dev.withpropeller.com
