# Local dev — copy to .env.local
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Datastores (defaults match docker-compose)
DATABASE_URL=mongodb://localhost:27017/propeller
TB_ADDRESSES=localhost:4000
FLO_ADDR=localhost:9000

# Public URL (used in OpenAPI server entries, webhook signing, etc.)
PUBLIC_URL=http://localhost:3001

# Provider keys land in Wave 1+ — secrets in Rune for deployed envs
