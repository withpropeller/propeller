# Multi-stage Dockerfile for Propeller Go workers.
#
# Builds a single worker module (GOWORK=off) with local replace deps copied
# into the image. Do not copy go.work — it lists the full monorepo workspace.
#
# Build arguments:
#   WORKER_DIR  — path under repo root (e.g. workers/notifications)
#
# Usage:
#   docker build \
#     -f infra/docker/Dockerfile.worker \
#     --build-arg WORKER_DIR=workers/notifications \
#     -t propeller-notifications .

FROM golang:1.25-alpine AS builder
ARG WORKER_DIR
RUN apk add --no-cache git
ENV GOWORK=off
# flo-go dev tags may exist on GitHub before proxy.golang.org indexes them
ENV GOPRIVATE=github.com/floruntime/flo-go
WORKDIR /repo

# Local modules referenced via replace in the worker's go.mod
COPY libs/go-events ./libs/go-events
COPY ${WORKER_DIR}/go.mod ./${WORKER_DIR}/

WORKDIR /repo/${WORKER_DIR}
RUN go mod download

WORKDIR /repo
COPY ${WORKER_DIR} ./${WORKER_DIR}/

WORKDIR /repo/${WORKER_DIR}
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/worker .

# ------------------------------------------------------------------------------

FROM alpine:3.21
ARG WORKER_DIR
RUN apk add --no-cache ca-certificates
WORKDIR /app

COPY --from=builder /out/worker ./worker
COPY ${WORKER_DIR}/templates ./templates

USER nobody
CMD ["./worker"]
