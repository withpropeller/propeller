## Tag and push a release
tag:
    arg: <ref> [string] "Release tag (e.g., v0.1.7-beta.91.58)"
    script:
        @git add .
        @git commit -m "pushing {{ref}}"
        @git tag -a {{ref}} -m "pushing {{ref}}"
        @git push origin {{ref}}

## Trigger manual deploy via deploy-component.yml
deploy:
    arg: <environment> [string] "Environment: stg or prod"
    arg: <components> [string...] "Component(s) to deploy (e.g. landing api docs)"
    flag: --branch|-b [string=""] "Git ref to deploy from (current branch if empty)"
    script:
        let components = zake::str.join("{{components}}", ",")
        @
            case "{{environment}}" in
                stg|prod) ;;
                *) echo "Error: Environment must be stg or prod"; exit 1 ;;
            esac

            COMPONENTS="{{components}}"
            if [ -z "$COMPONENTS" ]; then
                echo "Error: At least one component must be specified"
                exit 1
            fi

            BRANCH="{{branch}}"
            if [ -z "$BRANCH" ]; then
                BRANCH=$(git symbolic-ref -q HEAD | sed 's|refs/heads/||' || echo "HEAD")
            fi

            echo "🔨 Deploying: $COMPONENTS to {{environment}} from $BRANCH..."
            gh workflow run deploy-component.yml \
                -f environment={{environment}} \
                -f components="$COMPONENTS" \
                --ref "$BRANCH"

            echo ""
            echo "✅ Deploy triggered. Watch progress at:"
            echo "   https://github.com/withpropeller/propeller/actions"
