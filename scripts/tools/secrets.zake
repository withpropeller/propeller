##  Zakefile — Propeller Secrets
##
##  Manages Rune secrets across all environments.
##
##  Usage:
##    zake secrets init                        # Prompt + set all secrets for all envs
##    zake secrets init prod                   # Prompt + set for single env
##    zake secrets view dev propeller-providers # View all keys in a secret
##    zake secrets view dev propeller-core PAYSTACK_SECRET_KEY  # View full value
##    zake secrets set dev propeller-core PAYSTACK_SECRET_KEY sk_live_123
##    zake secrets generate                    # Generate random secrets and print env vars
##
##  Secrets are encrypted at rest in Rune. Never commit real values.

# ═══════════════════════════════════════════════════════════════════════════════
#  secrets init [env]
#  Guided interactive setup for all secret groups.  Prompts for each
#  value; press Enter to keep the existing value (if any).
# ═══════════════════════════════════════════════════════════════════════════════

## Initialize secrets (guided interactive)
secrets.init:
    arg: <environment> [string] "Target env: dev, stg, prod, or all (default: all)"
    script:
        if [ "{{environment}}" = "all" ]; then
            ENVS=(dev stg prod)
        else
            ENVS=("{{environment}}")
        fi

        echo ""
        echo "🔐  Propeller Secrets — Interactive Setup"
        echo ""

            # Check rune CLI and context
        if ! command -v rune &>/dev/null; then
            echo "❌ rune CLI not found. Install: https://docs.runestack.io/start/installation/"
            exit 1
        fi

        if ! rune whoami &>/dev/null 2>&1; then
            echo "❌ Not logged into Rune. Run: rune login ..."
            exit 1
        fi

        echo "✅ Authenticated as: $(rune whoami 2>/dev/null | grep 'Name:' | awk '{print $2}')"
        echo ""

            # Ensure namespace exists
        rune get ns propeller &>/dev/null 2>&1 || {
            echo "📦 Creating namespace 'propeller'..."
            rune create ns propeller --create-namespace 2>/dev/null || true
        }

            # Iterate over environments
        for ENV in "$${ENVS[@]}"; do
            echo "┌─ Setting secrets for $ENV ─────────────────"
            echo ""

                # propeller-core ──────────────────────────
            echo "  📦 propeller-core (shared: ledger + datastore)"
            rune get secret propeller-core -n propeller 2>/dev/null >/tmp/existing-secret.txt 2>&1 || true
            EXISTING_JSON=$(rune get secret propeller-core -n propeller -o json 2>/dev/null || echo "{}")
            for PAIR in \
                "DATABASE_URL:MongoDB Atlas URI" \
                "TB_CLUSTER_ID:TigerBeetle cluster ID" \
                "TB_ADDRESSES:TigerBeetle addresses (host1:4000,...)" \
                "SENTRY_DSN:Sentry DSN"; do
                KEY="${PAIR%%:*}"
                DESC="${PAIR#*:}"
                CURRENT=$(echo "$EXISTING_JSON" | jq -r ".data.\"$KEY\" // empty" 2>/dev/null || echo "")
                if [ -n "$CURRENT" ]; then
                    echo -n "    $KEY ($DESC) [****]: "
                else
                    echo -n "    $KEY ($DESC): "
                fi
                read -s VAL
                echo ""
                if [ -z "$VAL" ] && [ -n "$CURRENT" ]; then
                    echo "      ↳ kept existing"
                    continue
                fi
                if [ -z "$VAL" ]; then
                    echo "      ↳ skipped"
                    continue
                fi
                data_args="$data_args $KEY=$VAL"
            done
            if [ -n "$data_args" ]; then
                rune create secret propeller-core --data $data_args -n propeller --create-namespace 2>&1 | head -3
                echo "      ✅ propeller-core updated"
            fi
            unset data_args
            echo ""

                # propeller-providers ─────────────────────
            echo "  📦 propeller-providers (API keys)"
            EXISTING_JSON=$(rune get secret propeller-providers -n propeller -o json 2>/dev/null || echo "{}")
            for PAIR in \
                "PAYSTACK_SECRET_KEY:Paystack secret key" \
                "PAYSTACK_WEBHOOK_SECRET:Paystack webhook secret" \
                "PAYKKA_PRIVATE_KEY_PEM:PayKKa private key PEM" \
                "PAYKKA_PUBLIC_KEY_PEM:PayKKa public key PEM" \
                "PAYKKA_KEY_ID:PayKKa key ID" \
                "PAYKKA_MERCH_ID:PayKKa merchant ID" \
                "PAYKKA_BASE_URL:PayKKa base URL" \
                "DOJAH_APP_ID:Dojah app ID" \
                "DOJAH_PUBLIC_KEY:Dojah public key" \
                "DOJAH_SECRET_KEY:Dojah secret key" \
                "DOJAH_WEBHOOK_SECRET:Dojah webhook secret" \
                "GLOBALSTACK_API_KEY:Globalstack API key" \
                "GLOBALSTACK_WEBHOOK_SECRET:Globalstack webhook secret" \
                "GLOBALSTACK_BASE_URL:Globalstack base URL"; do
                KEY="${PAIR%%:*}"
                DESC="${PAIR#*:}"
                CURRENT=$(echo "$EXISTING_JSON" | jq -r ".data.\"$KEY\" // empty" 2>/dev/null || echo "")
                if [ -n "$CURRENT" ]; then
                    echo -n "    $KEY ($DESC) [****]: "
                else
                    echo -n "    $KEY ($DESC): "
                fi
                read -s VAL
                echo ""
                if [ -z "$VAL" ] && [ -n "$CURRENT" ]; then
                    echo "      ↳ kept existing"
                    continue
                fi
                if [ -z "$VAL" ]; then
                    echo "      ↳ skipped"
                    continue
                fi
                data_args="$data_args $KEY=$VAL"
            done
            if [ -n "$data_args" ]; then
                rune create secret propeller-providers --data $data_args -n propeller --create-namespace 2>&1 | head -3
                echo "      ✅ propeller-providers updated"
            fi
            unset data_args
            echo ""

                # propeller-services ─────────────────────
            echo "  📦 propeller-services (dashboard)"
            EXISTING_JSON=$(rune get secret propeller-services -n propeller -o json 2>/dev/null || echo "{}")
            CURRENT=$(echo "$EXISTING_JSON" | jq -r '.data.SESSION_SECRET // empty' 2>/dev/null || echo "")
            if [ -n "$CURRENT" ]; then
                echo -n "    SESSION_SECRET (32-byte base64) [****]: "
            else
                echo -n "    SESSION_SECRET (32-byte base64 — Enter for random): "
            fi
            read -s VAL
            echo ""
            if [ -z "$VAL" ] && [ -n "$CURRENT" ]; then
                echo "      ↳ kept existing"
            elif [ -z "$VAL" ]; then
                VAL=$(openssl rand -base64 32)
                echo "      ↳ generated: ${VAL:0:8}..."
                rune create secret propeller-services --data "SESSION_SECRET=$VAL" -n propeller --create-namespace 2>&1 | head -3
            else
                rune create secret propeller-services --data "SESSION_SECRET=$VAL" -n propeller --create-namespace 2>&1 | head -3
            fi
            echo "      ✅ propeller-services updated"
            echo ""

                # propeller-office ───────────────────────
            echo "  📦 propeller-office (admin)"
            EXISTING_JSON=$(rune get secret propeller-office -n propeller -o json 2>/dev/null || echo "{}")
            for PAIR in \
                "CF_ACCESS_AUD:Cloudflare Access audience" \
                "CF_ACCESS_TEAM_DOMAIN:Cloudflare Team domain"; do
                KEY="${PAIR%%:*}"
                DESC="${PAIR#*:}"
                CURRENT=$(echo "$EXISTING_JSON" | jq -r ".data.\"$KEY\" // empty" 2>/dev/null || echo "")
                if [ -n "$CURRENT" ]; then
                    echo -n "    $KEY ($DESC) [****]: "
                else
                    echo -n "    $KEY ($DESC): "
                fi
                read -s VAL
                echo ""
                if [ -z "$VAL" ] && [ -n "$CURRENT" ]; then
                    echo "      ↳ kept existing"
                    continue
                fi
                if [ -z "$VAL" ]; then
                    echo "      ↳ skipped"
                    continue
                fi
                data_args="$data_args $KEY=$VAL"
            done
            if [ -n "$data_args" ]; then
                rune create secret propeller-office --data $data_args -n propeller --create-namespace 2>&1 | head -3
                echo "      ✅ propeller-office updated"
            fi
            unset data_args
            echo ""
        done

        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "✅ All secrets initialized."
        echo ""

# ═══════════════════════════════════════════════════════════════════════════════
#  secrets view <secret-name> [key]
#  View secrets across all envs (values truncated unless a specific key)
# ═══════════════════════════════════════════════════════════════════════════════

## View secrets (values truncated)
secrets.view:
    arg: <environment> [string] "Target env: dev, stg, prod, or all"
    arg: <secret_name> [string] "Rune secret name (e.g. propeller-providers)"
    arg: <key> [string] "Specific key to show full value for"
    script:
        if ! command -v rune &>/dev/null; then
            echo "❌ rune CLI not found."
            exit 1
        fi

        ENV="{{environment}}"
        NAME="{{secret_name}}"
        KEY="{{key}}"

        if [ "$ENV" = "all" ]; then
            ENVS=(dev stg prod)
        else
            ENVS=("$ENV")
        fi

            # If no name given, show all secret names
        if [ -z "$NAME" ]; then
            for e in "${ENVS[@]}"; do
                echo "  📦 $e:"
                rune get secrets -n propeller 2>/dev/null | grep -v '^NAME' || echo "    (none)"
            done
            exit 0
        fi

        for e in "${ENVS[@]}"; do
            JSON=$(rune get secret "$NAME" -n propeller -o json 2>/dev/null || echo "{}")
            if [ "$JSON" = "{}" ]; then
                echo "❌ $e: $NAME — not found"
                continue
            fi

            if [ -n "$KEY" ]; then
                VAL=$(echo "$JSON" | jq -r ".data.\"$KEY\" // empty" 2>/dev/null)
                if [ -z "$VAL" ]; then
                    echo "❌ $e/$NAME: key '$KEY' not found"
                    echo "   Available: $(echo "$JSON" | jq -r '.data | keys[]' 2>/dev/null | tr '\n' ' ')"
                else
                    echo "$e/$NAME → $KEY:"
                    echo "$VAL"
                fi
            else
                echo ""
                echo "📦 $e/$NAME ($(echo "$JSON" | jq '.data | length') keys):"
                echo "$JSON" | jq -r '.data | to_entries[] | "  \(.key): \(.value | if type=="string" and length>30 then .[:30]+"..." else . end)"'
            fi
        done
        echo ""

# ═══════════════════════════════════════════════════════════════════════════════
#  secrets set <secret-name> <key> <value>
# ═══════════════════════════════════════════════════════════════════════════════

## Set a single secret key (prompts securely if value omitted)
secrets.set:
    arg: <environment> [string] "Target env: dev, stg, prod"
    arg: <secret_name> [string] "Rune secret name"
    arg: <key> [string] "Key name"
    arg: <value> [string?] "Secret value (omit to be prompted with hidden input)"
    script:
        @
            VALUE="{{value}}"
            if [ -z "$VALUE" ]; then
                printf "Enter value for %s: " "{{key}}" > /dev/tty
                IFS= read -rs VALUE < /dev/tty
                echo "" > /dev/tty
                if [ -z "$VALUE" ]; then
                    echo "❌ Value cannot be empty"
                    exit 1
                fi
            fi

            rune secret set "{{secret_name}}" \
                "{{key}}=$VALUE" \
                -n "{{environment}}" 2>&1
            echo "✅ Set {{environment}}/propeller/{{secret_name}} → {{key}}"

# ═══════════════════════════════════════════════════════════════════════════════
#  secrets generate
#  Generate random secrets and print ready-to-source env vars
# ═══════════════════════════════════════════════════════════════════════════════

## Generate random secrets and print env vars
secrets.generate:
    script:
        $
            SESSION_SECRET=$(openssl rand -base64 32)
            echo ""
            echo "# Copy these and run:  source <(zake secrets generate)"
            echo ""
            echo "export SESSION_SECRET=\"$SESSION_SECRET\""
            echo "export PAYSTACK_SECRET_KEY=\"sk_live_...\""
            echo "export PAYSTACK_WEBHOOK_SECRET=\"...\""
            echo "# ... set the rest, then run:"
            echo "#"
            echo "#   zake secrets init"
            echo ""
